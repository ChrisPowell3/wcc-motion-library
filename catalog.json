{
  "library": "@wcc/motion-library",
  "version": "0.4.0",
  "pieces": [
    {
      "id": "swipe-carousel",
      "name": "Swipe Carousel",
      "export": "SwipeCarousel",
      "summary": "Swipe through your own card designs or image cards that gently settle in the center.",
      "status": "ready",
      "settings": {
        "items": {
          "type": "readonly T[] where T extends {id: string}",
          "default": [],
          "required": true,
          "min": 0,
          "max": null,
          "description": "Required array with unique stable IDs; empty lists supported. Without renderCard, use the existing SwipeCarouselItem image/alt/title/text/optional cta shape. Other item shapes require renderCard."
        },
        "startIndex": {
          "type": "number",
          "default": "Math.floor(items.length / 2)",
          "min": 0,
          "max": "items.length - 1",
          "description": "Initial zero-based card; rounded and clamped. Later changes do not control selection."
        },
        "cardWidth": {
          "type": "string",
          "default": "clamp(220px, 70vw, 360px)",
          "options": [
            "Any valid CSS width, e.g. 280px, 70vw, or clamp(220px, 70vw, 360px)"
          ],
          "description": "Capped to carousel width minus 32px. The cardAspect prop controls the aspect ratio."
        },
        "gap": {
          "type": "number",
          "default": 0.55,
          "min": 0.3,
          "max": 1.1,
          "description": "Distance between card centers as a share of card width; clamped to range."
        },
        "sideScale": {
          "type": "number",
          "default": 0.8,
          "min": 0.6,
          "max": 1,
          "description": "Scale of side cards; clamped to range."
        },
        "fanOnView": {
          "type": "boolean",
          "default": true,
          "options": [
            true,
            false
          ],
          "description": "Fan out once per mounted carousel when it enters view; scrolling out and back does not replay."
        },
        "showDots": {
          "type": "boolean",
          "default": true,
          "options": [
            true,
            false
          ]
        },
        "onChange": {
          "type": "(index: number) => void",
          "default": null,
          "options": [
            "undefined",
            "function"
          ],
          "description": "Called once when the selected index changes, including data shrinking; not on initial render or selecting the current card."
        },
        "label": {
          "type": "string",
          "default": "Image carousel",
          "options": [
            "Any non-empty accessible name"
          ],
          "description": "Accessible name for the carousel region, e.g. What\u2019s Inside. Use a distinct name when a page has multiple carousels."
        },
        "renderCard": {
          "type": "(item: T, state: SwipeCarouselCardState) => ReactNode",
          "default": null,
          "options": [
            "undefined (built-in image card)",
            "function"
          ],
          "description": "Replaces all content inside the motion frame. State: index (zero-based), count, active (selected center/destination), ready (active and settled, when built-in text begins fading), loadImage (center plus immediate neighbors first, all cards after fan-out or interaction). Gate image src with loadImage. Custom content stays inert off-center and while settling. Required for item shapes other than SwipeCarouselItem."
        },
        "cardAspect": {
          "type": "string",
          "default": "3 / 4",
          "options": [
            "Any positive CSS aspect ratio, e.g. 1 / 1 or 4 / 3",
            "auto"
          ],
          "description": "Frame aspect ratio. Use auto with in-flow custom content to size the card by its contents; height is not animated."
        },
        "cardStyle": {
          "type": "{borderRadius?: CSSProperties[\"borderRadius\"], background?: CSSProperties[\"background\"], boxShadow?: CSSProperties[\"boxShadow\"]}",
          "default": {
            "borderRadius": 24,
            "background": "#23373d",
            "boxShadow": "0 12px 24px -16px rgba(0,0,0,.55)"
          },
          "options": [
            "Object containing any subset of borderRadius, background and boxShadow"
          ],
          "description": "Static frame decoration; omitted fields retain the built-in look. Width, aspect, transforms, opacity and stacking remain controlled by the carousel."
        },
        "dimColor": {
          "type": "string",
          "default": "transparent",
          "options": [
            "transparent (legacy frame opacity)",
            "Any CSS color, e.g. #f3f0e9"
          ],
          "description": "With a color, frames stay at opacity 1 and a non-interactive overlay dims contents by distance: 0 at center, 0.1 one away, 0.4 two away, 0.7 three or more away. Use the page background color with opaque card backgrounds to prevent cards showing through each other. transparent preserves original frame opacity fading."
        },
        "dials": {
          "type": "MotionDials",
          "default": {},
          "options": [
            "Object of supported dial ids with exact word values from SHARED_DIALS and PIECE_DIALS"
          ],
          "description": "Validated with cleanDials. Unknown ids/values and unsupported dials are ignored. Existing explicit props override dials; absent values retain piece defaults. See dials, dialDefaults and unsupportedDials."
        }
      },
      "reducedMotion": "Live system reduced-motion preference stops autoplay, fan-out, springs and fade transitions. Navigation settles instantly; direct dragging, horizontal wheel and all controls remain available. Server active content is fully visible before client entrance setup.",
      "demo": "demo/swipe-carousel.html",
      "dials": [
        "speed",
        "size",
        "bounce",
        "autoplay",
        "loop",
        "sideCards",
        "flick"
      ],
      "dialDefaults": {
        "speed": "normal",
        "size": "medium",
        "bounce": "soft",
        "autoplay": "off",
        "loop": "off",
        "sideCards": "normal",
        "flick": "normal"
      },
      "unsupportedDials": [
        "plays",
        "delay",
        "cascade",
        "direction",
        "fade",
        "start",
        "blur"
      ]
    },
    {
      "id": "scroll-reveal-rise",
      "name": "Scroll Reveal Rise",
      "export": "ScrollRevealRise",
      "summary": "Content gently rises up and fades in as you scroll down to it, with images taking a touch longer and any group of items following one another in a quick cascade.",
      "status": "ready",
      "settings": {
        "children": {
          "type": "ReactNode | ReactNode[]",
          "default": null,
          "required": true,
          "options": [
            "ReactNode",
            "ReactNode[]"
          ],
          "description": "Required semantic content. Direct children animate separately; fragments animate as one item. Use stable keys for arrays. Supply alt text on images and accessible names on buttons. Each item adds two block wrappers; use in flow/grid/flex, not inside paragraphs or tag-constrained lists/tables."
        },
        "as": {
          "type": "string",
          "default": "block",
          "options": [
            "block",
            "image",
            "button"
          ],
          "description": "Motion preset, not an HTML tag. block/button: 24px, base, 0.5 opacity; image: 64px, slow, 0 opacity. Use image for large hero blocks too."
        },
        "distance": {
          "type": "number",
          "default": 24,
          "min": 8,
          "max": 120,
          "description": "Pixels below rest; image default is 64. Clamped; non-finite values use the preset default."
        },
        "duration": {
          "type": "'fast' | 'base' | 'slow' | number",
          "default": "base",
          "options": [
            "fast",
            "base",
            "slow"
          ],
          "min": 0,
          "max": 5,
          "description": "Named house duration, or seconds. Images default to slow. Numeric duration supports exact named-token presets."
        },
        "stagger": {
          "type": "number",
          "default": 90,
          "min": 0,
          "max": 300,
          "description": "Milliseconds between direct siblings. Delay starts only after each item intersects, capped at nine beats and durations.entrance (900ms). Initial visible items cap delay at durations.fast. Non-finite values use 90."
        },
        "startOpacity": {
          "type": "number",
          "default": 0.5,
          "min": 0,
          "max": 0.6,
          "description": "Image default is 0, following the explicit prop contract. Use 0.5 for translucent images. Non-finite values use the preset default; initial visible items start at 0.8."
        },
        "once": {
          "type": "boolean",
          "default": true,
          "options": [
            true,
            false
          ],
          "description": "One entrance per mounted keyed child. false instantly resets outside view for replay; focused content remains visible. Remount to restart a one-time reveal."
        },
        "margin": {
          "type": "string",
          "default": "0px 0px -10% 0px",
          "options": [
            "1\u20134 signed px or % values accepted by IntersectionObserver"
          ],
          "description": "Negative bottom margin starts slightly inside the viewport, before full visibility; percentages use root width. Threshold 0 observes stationary anchors. Initially visible items observe the actual viewport (zero margin). Invalid margins or missing observers fail open."
        },
        "dials": {
          "type": "MotionDials",
          "default": {},
          "options": [
            "Object of supported dial ids with exact word values from SHARED_DIALS and PIECE_DIALS"
          ],
          "description": "Validated with cleanDials. Unknown ids/values and unsupported dials are ignored. Existing explicit props override dials; absent values retain piece defaults. See dials, dialDefaults and unsupportedDials. start early/middle/late uses 10/25/40% of viewport height, recalculated on resize; an explicit margin keeps native px/% semantics."
        },
        "blur": {
          "type": "number",
          "default": 0,
          "min": 0,
          "max": 10,
          "description": "Entrance only; filter ends at none. Strong=10px, soft=6px. The image preset ignores blur for scroll triggers to keep large images sharp."
        },
        "delay": {
          "type": "number",
          "default": 0,
          "min": 0,
          "max": 5000,
          "description": "Milliseconds before entrance, in addition to sibling stagger."
        },
        "trigger": {
          "type": "'scroll' | 'load'",
          "default": "scroll",
          "options": [
            "scroll",
            "load"
          ],
          "description": "Explicit trigger wins over start dial; load plays once per mount."
        }
      },
      "reducedMotion": "useReducedMotion plus a live system preference listener skip transform, opacity animation and delays entirely. All content renders at rest and fully opaque, including during a preference change. No prop overrides the preference. Server HTML is also fully visible.",
      "demo": "demo/scroll-reveal-rise.html",
      "dialDefaultsByPreset": {
        "image": {
          "speed": "slow",
          "bounce": "none",
          "fade": "full",
          "blur": "none"
        }
      },
      "dials": [
        "speed",
        "size",
        "bounce",
        "plays",
        "delay",
        "cascade",
        "direction",
        "fade",
        "start",
        "blur"
      ],
      "dialDefaults": {
        "speed": "normal",
        "size": "medium",
        "bounce": "soft",
        "plays": "once",
        "delay": "none",
        "cascade": "cascade",
        "direction": "up",
        "fade": "soft",
        "start": "early",
        "blur": "none"
      },
      "unsupportedDials": [
        "autoplay",
        "loop",
        "sideCards",
        "flick"
      ]
    },
